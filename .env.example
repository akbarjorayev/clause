# Copy this file to .env and fill in your values.

# Meta Model API key (server only, never sent to the browser).
MUSE_API_KEY=

# Optional: set to "fixture" to replay a saved Muse answer instead of calling the API (free, no key needed).
# Leave unset in production.
# MUSE_MODE=fixture

# Public URL of the deployed site, used for links, the sitemap and sharing images.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
